# Private local lab only. Copy to .env and replace both passwords before use.
# URL-sensitive characters are supported by the discrete DB_* application config.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
APP_VERSION=local
APP_IMAGE=launchops:local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-another-long-random-password

# Keep artifacts/status across release directories; use absolute shared paths on AWS.
BACKUP_DIRECTORY=./backups
BACKUP_STATUS_DIRECTORY=./runtime/backup-status
# No automatic cloud transfer. Set only for an explicitly authorized host-side S3 run.
BACKUP_S3_URI=

# Optional loopback port overrides. Defaults preserve the cloud/CI layout.
APP_PORT=8000
RESTORED_APP_PORT=8001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
HTTPS_PORT=8443
